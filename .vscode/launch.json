    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Main",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "purpose": ["debug","run"],
            "justMyCode": false
        },
        {
            "name": "Python: Run Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "purpose": ["run"],
            "justMyCode": false
        }
    ],
    "compounds": [
        {
            "name": "Run and Debug Main",
            "configurations": ["Python: Main"]
        }
    ]
}
